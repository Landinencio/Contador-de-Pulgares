<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono pequeño de las notificaciones del Cobrador del Frac. Android lo pinta
  como silueta monocroma, así que es la forma la que tiene que contar el chiste:
  una chistera sobre el monigote.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Copa de la chistera -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8,2 h8 c0.55,0 1,0.45 1,1 v5 h-10 v-5 c0,-0.55 0.45,-1 1,-1 Z" />

    <!-- Ala -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.5,8.6 h15 c0.5,0 0.9,0.4 0.9,0.9 c0,0.5 -0.4,0.9 -0.9,0.9 h-15 c-0.5,0 -0.9,-0.4 -0.9,-0.9 c0,-0.5 0.4,-0.9 0.9,-0.9 Z" />

    <!-- El cuerpo-alubia del monigote -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,11.4 c3.6,0 5.6,2.2 5.6,5.6 v2.6 c0,1.3 -1,2.4 -2.3,2.4 h-6.6 c-1.3,0 -2.3,-1.1 -2.3,-2.4 v-2.6 c0,-3.4 2,-5.6 5.6,-5.6 Z" />
</vector>
